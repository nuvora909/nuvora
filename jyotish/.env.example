# Copy non-secret settings into the server environment; never commit live credentials.
NUVORA_AUTH_DB=data/nuvora.sqlite3
NUVORA_DEFAULT_COUNTRY=GB
# Enable only when the origin is reachable through a trusted CDN/proxy that overwrites these headers.
NUVORA_TRUST_GEO_HEADERS=false
# Set a strong private secret (16+ characters); never commit the real value.
NUVORA_ADMIN_EMAIL=nuvora909@gmail.com
NUVORA_ADMIN_PASSWORD=
# Google Identity Services web client ID. Localhost is allowed by Google during development.
NUVORA_GOOGLE_CLIENT_ID=
PAYPAL_MODE=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# Checkout is blocked until both a real refund/cancellation policy and support contact are published.
NUVORA_REFUND_POLICY_TEXT=
NUVORA_SUPPORT_EMAIL=
# YouPI-PG secrets are server-only. Keep checkout disabled until statement reconciliation is operational.
YOUPI_CHECKOUT_ENABLED=false
YOUPI_API_URL=
YOUPI_MERCHANT_ID=
YOUPI_MERCHANT_API_KEY=
YOUPI_WEBHOOK_SECRET=
# Exact HTTPS app return URL allowlisted in YOUPI_ALLOWED_RETURN_ORIGINS.
YOUPI_RETURN_URL=
# AI reader: "openai" (any OpenAI-compatible endpoint) or "anthropic". Keep the key out of version control.
LLM_PROVIDER=
LLM_MODEL=
LLM_BASE_URL=
LLM_API_KEY=
# Seconds to wait for the provider between streamed chunks. Free hosted tiers can queue for minutes.
LLM_TIMEOUT=180
# Backup models tried in order if LLM_MODEL is retired or busy; if all are gone, a model is
# chosen automatically from the provider's catalogue.
LLM_FALLBACK_MODELS=
# Thinking models spend part of the budget reasoning before they answer.
LLM_MAX_TOKENS=16000
LLM_REASONING_EFFORT=low
# Optional second provider (OpenAI-compatible, e.g. https://openrouter.ai/api/v1), used when every
# primary model fails. Leave LLM_BACKUP_MODELS empty to pick free models automatically.
LLM_BACKUP_BASE_URL=
LLM_BACKUP_API_KEY=
LLM_BACKUP_MODELS=
