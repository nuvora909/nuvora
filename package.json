{
  "name": "nuvora",
  "version": "0.1.0",
  "private": true,
  "description": "Nuvora learning platform: website, student portal, database and automation",
  "type": "module",
  "scripts": {
    "dev": "node server/dev-server.mjs",
    "seed": "node scripts/build-seed.mjs",
    "build:site": "node scripts/build-site.mjs",
    "test": "node tests/run-3x.mjs",
    "test:db": "node --test --test-concurrency=4 \"tests/db/*.test.mjs\"",
    "test:server": "node --test \"tests/server/*.test.mjs\"",
    "test:site": "node --test \"tests/site/*.test.mjs\"",
    "test:e2e": "playwright test",
    "test:once": "node --test \"tests/db/*.test.mjs\" \"tests/server/*.test.mjs\" \"tests/site/*.test.mjs\" && playwright test",
    "test:sabotage": "node tests/sabotage.mjs"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@playwright/test": "^1.63.0"
  },
  "dependencies": {
    "nodemailer": "^10.0.15"
  }
}
